APP_NAME=LeakShield Pro
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./leakshield.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
CACHE_TTL_SECONDS=3600
MAX_SCAN_BYTES=420000
ADMIN_ACCOUNTS_JSON=[{"email":"owner@example.com","password":"replace-with-a-long-unique-password"}]
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

